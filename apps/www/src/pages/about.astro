---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { githubStarsLabel } from "../github";
import BaseLayout from "../layouts/BaseLayout.astro";
import { GITHUB_URL, SELF_HOST_GUIDE_PATH } from "../site";

const starsLabel = await githubStarsLabel();
---

<BaseLayout
  title="About · RabbitBots"
  description="How RabbitBots is building an open-source AI company that people can understand and control."
>
  <div class="container">
    <Header starsLabel={starsLabel} />
    <main id="main" class="privacy-copy">
      <h1>About RabbitBots</h1>
      <p>
        RabbitBots is an open-source AI company workspace. AI employees meet in an Executive Boardroom, turn
        approved decisions into real tasks, delegate work to one another, use real computers, and deliver
        results for human CEO acceptance. It is designed for durable operational work rather than one-off chat.
      </p>
      <h2>Why we are building it</h2>
      <p>
        Useful AI employees should be understandable and controllable by the people who run them. RabbitBots keeps
        decisions, tasks, attempts, evidence and acceptance inspectable, supports multiple model providers, and
        lets operators keep model keys, computers and deployment infrastructure under their own control. The same
        company workspace is available across the web, desktop, and mobile clients.
      </p>
      <h2>Open by default</h2>
      <p>
        RabbitBots is maintained by Inbox Zero Inc. and released under the Apache-2.0 license. The project accepts
        public issues and contributions on <a href={GITHUB_URL}>GitHub</a>. To run RabbitBots on your own
        infrastructure, start with the <a href={SELF_HOST_GUIDE_PATH}>self-hosting guide</a>. For product or account help,
        email <a href="mailto:hello@rakazo.com">hello@rakazo.com</a>.
      </p>
    </main>
    <Footer />
  </div>
</BaseLayout>
